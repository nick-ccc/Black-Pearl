#!/usr/bin/env bash

set -euo pipefail

echo "Running secret checks..."

# 1. Files under secrets/ must be valid SOPS files.
while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    [[ "$file" == "secrets/.gitkeep" ]] && continue

    if ! sops -d "$file" >/dev/null 2>&1; then
        echo
        echo "ERROR: $file is not a valid SOPS-encrypted file."
        exit 1
    fi
done < <(git diff --cached --name-only --diff-filter=ACM -- 'secrets/*')


# 2. Look for obvious plaintext secret fields in staged files.
if git diff --staged --unified=0 |
    grep -E '^\+[^+].*(password|passwd|token|secret|api[_-]?key)[[:space:]]*:' |
    grep -vE '^[+].*(password|passwd|token|secret|api[_-]?key)[[:space:]]*:[[:space:]]*($|null|""|'\'''\''|<[^>]+>)'
then
    echo
    echo "ERROR: Possible plaintext secret detected."
    echo
    echo "Put secrets in a SOPS-encrypted file instead."
    exit 1
fi


# 3. Gitleaks catches higher-confidence secret patterns.
if ! gitleaks git --staged --redact; then
    echo
    echo "ERROR: Gitleaks detected a potential secret."
    exit 1
fi

echo "Secret checks passed."
