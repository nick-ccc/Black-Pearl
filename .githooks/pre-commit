#!/usr/bin/env bash

set -euo pipefail

echo "Running secret checks..."

# 1. Anything under secrets/ must be valid SOPS.
while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    [[ "$file" == "secrets/.gitkeep" ]] && continue

    if ! sops -d "$file" >/dev/null 2>&1; then
        echo
        echo "ERROR: $file is not a valid SOPS-encrypted file."
        exit 1
    fi
done < <(git diff --staged --name-only --diff-filter=ACM -- 'secrets/*')


# 2. Gitleaks scans the entire staged repository too.
if ! gitleaks git --staged --redact --config .gitleaks.toml; then
    echo
    echo "ERROR: Gitleaks detected a potential secret."
    exit 1
fi

echo "Secret checks passed."
